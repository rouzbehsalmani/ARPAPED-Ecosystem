{
  "version": "1.1.0",
  "kind": "agent_execution_contract",
  "authority": "ARPAPED Self-Improving Cycle Blueprint",
  "startup": {
    "require_ecosystem_root": true,
    "require_authoritative_metadata": true,
    "require_canonical_bridge_resolution": true,
    "require_registry_resolution": true,
    "require_policy_resolution": true,
    "require_current_state_resolution": true
  },
  "execution": {
    "cycle_model": "recursive_state_transition",
    "product_specific_blueprint": false,
    "global_registry_scan": false,
    "private_bridge": false,
    "private_registry": false,
    "duplicate_existing_responsibility": false,
    "proactive_split_check": true
  },
  "verification": {
    "require_headless_execution": true,
    "require_scripted_input_simulation": true,
    "require_contract_operation_checks": true,
    "require_trace_validated_to_executed": true,
    "require_trace_evaluation": true,
    "require_trace_in_record": true,
    "require_operator_decision_window": true,
    "require_capability_decomposition": true,
    "require_request_path_discipline": true,
    "require_regression_tests_for_reported_defects": true,
    "require_verification_record": true,
    "publish_unverified_state": false
  },
  "decision_order": [
    "reuse",
    "compose",
    "split_or_refactor",
    "create"
  ],
  "publication": {
    "require_discoverability_record": true,
    "require_lineage": true,
    "require_contract": true,
    "require_version": true
  }
}

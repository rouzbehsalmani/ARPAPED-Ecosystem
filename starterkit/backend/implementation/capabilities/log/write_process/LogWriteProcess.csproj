<Project Sdk="Microsoft.NET.Sdk">

  <!-- A SECOND implementation of log.write, running out-of-process
       (executor_kind: process) instead of in-process, see ../write/executor.py
       and ../../../../README.md "A capability in another language". A real
       console-app project (this .csproj + Program.cs), not a single file
       compiled by bare `csc`; it references BridgeClient (../../../clients/csharp/,
       a ProjectReference) for all connect/frame/dispatch machinery, so this
       project's own code is just its operation logic. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>log_write_process</AssemblyName>
    <RootNamespace>LogWriteProcess</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../clients/csharp/BridgeClient.csproj" />
  </ItemGroup>

</Project>

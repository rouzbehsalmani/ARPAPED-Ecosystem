{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARPAPED Implementation Record",
  "type": "object",
  "required": [
    "implementation_id",
    "capability_id",
    "contract",
    "version",
    "dependencies",
    "discoverability",
    "lineage"
  ],
  "properties": {
    "implementation_id": {
      "type": "string"
    },
    "capability_id": {
      "type": "string"
    },
    "contract": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discoverability": {
      "type": "object"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "product_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_resolvable": {
      "type": "boolean"
    }
  }
}

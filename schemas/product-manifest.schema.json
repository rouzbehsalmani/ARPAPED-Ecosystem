{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARPAPED Product Manifest",
  "description": "Machine-readable declaration of a consumer product: its identity, the canonical Bridge/Registry it depends on, the capability contracts it requires, and the role->capability_id mapping. The product manifest references capability contract ids only (R3) and never concrete components.",
  "type": "object",
  "required": [
    "product",
    "dependencies",
    "roles"
  ],
  "properties": {
    "product": {
      "type": "object",
      "required": ["id", "name", "version", "domain"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier."
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Semantic version."
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "bridge": {
          "type": "string",
          "description": "Canonical Bridge version requirement, e.g. \">=1.0.0\"."
        },
        "registry": {
          "type": "string",
          "description": "Canonical Registry version requirement."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "description": "Capability contract ids the product requires (R3)."
        }
      },
      "required": ["capabilities"],
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "maxProperties": 1
      },
      "description": "Logical role -> capability_id mapping. Consumer code references roles only (R7), never concrete components."
    },
    "integration": {
      "type": "object",
      "required": ["entry_point"],
      "properties": {
        "entry_point": {
          "type": "string",
          "description": "Module path for product initialization, e.g. \"pkg:initialize\"."
        },
        "bridge_request_path": {
          "type": "string",
          "default": "canonical"
        }
      },
      "additionalProperties": false
    },
    "discoverability": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "support_contact": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

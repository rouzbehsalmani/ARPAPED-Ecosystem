{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARPAPED Component Contract",
  "description": "Machine-readable contract artifact for a capability (R2). One materialized, versioned file per capability. Defines identity, responsibility, versions (each a peer, full operations with input/output/errors), dependencies, policy, runtime, discoverability, versioning, and lineage. Inputs/outputs are generic contract-shaped data, never implementation types.",
  "$defs": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "errors"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "input": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean",
                  "default": false
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "output": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "description"],
              "properties": {
                "code": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "type": "object",
  "required": ["contract"],
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "identity",
        "responsibility",
        "versions",
        "dependencies",
        "discoverability",
        "versioning",
        "lineage"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "required": ["id", "name", "version", "domain", "family", "type"],
          "properties": {
            "id": {
              "type": "string",
              "description": "Generic capability identity per R1 (domain.operation), never product-prefixed."
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string",
              "description": "The default version for a consumer that doesn't pin one -- MUST be a key present in `versions`."
            },
            "domain": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": ["capability", "connector", "service"]
            }
          },
          "additionalProperties": false
        },
        "responsibility": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": {
              "type": "string"
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["operations"],
            "properties": {
              "operations": {"$ref": "#/$defs/operations"}
            },
            "additionalProperties": false
          },
          "description": "Every currently supported (alive) version of this contract's interface, keyed by version string. Each entry is a full, independent peer -- none is structurally privileged over another; `identity.version` only names which one is the default. A version that is fully retired (no implementation may declare it any more) is removed from here and recorded in `lineage.history` instead -- 'deprecated' means dead, not 'old but still usable'."
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "Shorthand for {capability_id: <this string>, contract_version: \"*\"} -- any registered version."
                  },
                  {
                    "type": "object",
                    "required": ["capability_id", "contract_version"],
                    "properties": {
                      "capability_id": {
                        "type": "string"
                      },
                      "contract_version": {
                        "type": "string",
                        "description": "The version constraint this contract was actually built and tested against (exact, range, or \"*\") -- what this dependency is resolved at is never something the depending capability's own code can drift from."
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "description": "Required capability contracts (R4), all more generic than this contract. A bare string means any version; {capability_id, contract_version} pins the version this contract depends on."
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provides": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "threading": {
              "type": "string",
              "enum": ["single", "multi", "thread-safe"]
            },
            "stateful": {
              "type": "boolean",
              "default": false
            },
            "lifecycle": {
              "type": "string",
              "enum": ["singleton", "transient", "scoped"]
            }
          },
          "additionalProperties": false
        },
        "discoverability": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "metadata": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "versioning": {
          "type": "object",
          "properties": {
            "compatibility": {
              "type": "string",
              "enum": ["backward", "forward", "strict"],
              "description": "Policy documentation for how this contract's maintainers intend to evolve `versions` -- not itself checked mechanically; whether a specific version is currently valid is answered directly by membership in `versions` vs. `lineage.history`."
            },
            "deprecation_policy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "lineage": {
          "type": "object",
          "properties": {
            "created_by": {
              "type": "string"
            },
            "changed_by": {
              "type": "string"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["version", "changed_by", "summary"],
                "properties": {
                  "version": {
                    "type": "string",
                    "description": "A version that is now dead -- no implementation may declare this as its contract_version any more."
                  },
                  "changed_by": {
                    "type": "string"
                  },
                  "changed_at": {
                    "type": "string",
                    "description": "ISO 8601 date/time. Optional."
                  },
                  "summary": {
                    "type": "string",
                    "description": "What changed and why this version was retired, in plain language."
                  }
                },
                "additionalProperties": false
              },
              "description": "Fully retired (dead) versions only. A version that still has a live, supported implementation belongs in `versions`, not here."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

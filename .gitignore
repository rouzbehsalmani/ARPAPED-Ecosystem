__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/

# Locally-built, platform-specific process executors (executor_kind:
# process) -- not committed, same posture as any other build artifact.
# *.exe/*.pdb cover a bare-compiled binary (rustc, csc) directly; bin/
# and obj/ cover everything a `dotnet build` produces (a project's own
# lock/config files, e.g. .csproj, .sln, ARE committed -- reproducible
# builds -- so they're deliberately not listed here).
*.exe
*.pdb
bin/
obj/

# Generated, mechanically-regenerable runtime/cycle state -- produced by
# running a sample's own build_catalog / verification harness /
# dataset_builder (see each sample's own README / 0-WALKTHROUGH.md).
# Never committed: an agent reading this repo should read contracts,
# manifests, and executors, then reproduce state itself by running the
# documented commands, not read accumulated run history baked into the
# blueprint.
**/state/
**/capability-catalog.jsonl
**/dataset.jsonl
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Locally-built, platform-specific process executors (executor_kind:
# process) -- not committed, same posture as any other build artifact.
# *.exe/*.pdb cover a bare-rustc-compiled binary, if one is ever built
# that way again; target/ covers everything a Cargo build produces (a
# binary crate's own Cargo.lock, e.g. .../compose_process/Cargo.lock, IS
# committed -- reproducible builds -- so it's deliberately not listed here).
*.exe
*.pdb
target/